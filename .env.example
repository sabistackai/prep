# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used to create nanny logins. Never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only: turns nanny PINs into their real passwords (at least 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing or losing it means every nanny needs a new setup link.
NANNY_PIN_SECRET=
